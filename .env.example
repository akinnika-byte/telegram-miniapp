# Скопируй этот файл в .env и подставь свои значения.
# .env в репозиторий НЕ коммитится.

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXX
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# Порт пулера 6543 (Supavisor) — для сервера на Render.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ===== Telegram =====
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
